---
import CopyButton from '@/components/CopyButton.tsx';

interface Props {
  codes: {
    code: string;
    reward: string;
    status: string;
    addedDate?: string;
    notes?: string;
  }[];
  showStatus?: boolean;
}

const { codes, showStatus = false } = Astro.props;
---
<div class="overflow-x-auto rounded-lg border border-gray-700">
  <table class="w-full text-sm">
    <thead>
      <tr class="bg-gray-800">
        <th class="px-4 py-3 text-left font-semibold text-gray-300">Code</th>
        <th class="px-4 py-3 text-left font-semibold text-gray-300">Reward</th>
        {showStatus && <th class="px-4 py-3 text-left font-semibold text-gray-300">Status</th>}
        <th class="px-4 py-3 text-left font-semibold text-gray-300 w-20">Copy</th>
      </tr>
    </thead>
    <tbody>
      {codes.map((c) => (
        <tr class="border-t border-gray-700/50 hover:bg-gray-800/50 transition-colors">
          <td class="px-4 py-3 font-mono font-bold text-amber-400">{c.code}</td>
          <td class="px-4 py-3 text-gray-200">{c.reward}</td>
          {showStatus && (
            <td class="px-4 py-3">
              {c.status === 'active' && <span class="text-green-400 font-medium">Active</span>}
              {c.status === 'limited' && <span class="text-yellow-400 font-medium">Limited</span>}
              {c.status === 'expired' && <span class="text-gray-500">Expired</span>}
              {c.status === 'unverified' && <span class="text-orange-400 font-medium">Unverified</span>}
            </td>
          )}
          <td class="px-4 py-3">
            {c.status !== 'expired' && <CopyButton client:load text={c.code} />}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
