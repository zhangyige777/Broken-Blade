---
interface Props {
  rows: { label: string; value: string }[];
  caption?: string;
}

const { rows, caption } = Astro.props;
---
<div class="rounded-lg border border-gray-700 overflow-hidden">
  {caption && (
    <div class="bg-gray-800 px-5 py-3 border-b border-gray-700">
      <h3 class="font-semibold text-gray-100 text-sm">{caption}</h3>
    </div>
  )}
  <table class="w-full">
    <tbody>
      {rows.map((row, i) => (
        <tr class={i % 2 === 0 ? 'bg-gray-800/30' : 'bg-gray-800/60'}>
          <td class="px-5 py-3 text-sm font-medium text-gray-300 w-1/3">{row.label}</td>
          <td class="px-5 py-3 text-sm text-gray-100">{row.value}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
