---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import DataDisclaimer from '@/components/DataDisclaimer.astro';
import RelatedGuides from '@/components/RelatedGuides.astro';
import SummaryTable from '@/components/SummaryTable.astro';
import FAQItem from '@/components/FAQItem.astro';
import { generateBreadcrumbSchema, generateFAQSchema } from '@/lib/data';

interface Props {
  title: string;
  description: string;
  quickAnswer?: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbItems: { name: string; url: string }[];
  schema?: object | object[];
  showDisclaimer?: boolean;
  relatedGuides?: { title: string; url: string; description: string }[];
  summaryRows?: { label: string; value: string }[];
  faq?: { question: string; answer: string }[];
}

const {
  title,
  description,
  quickAnswer,
  canonical,
  ogImage,
  breadcrumbItems,
  schema,
  showDisclaimer = true,
  relatedGuides,
  summaryRows,
  faq,
} = Astro.props;

const currentPath = canonical || Astro.url.pathname;

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbItems);

const schemas: object[] = [breadcrumbSchema];
if (schema) {
  const extraSchemas = Array.isArray(schema) ? schema : [schema];
  schemas.push(...extraSchemas);
}
if (faq && faq.length >= 3) {
  schemas.push(generateFAQSchema(faq));
}
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <JsonLd schema={schemas} />

  <article class="max-w-4xl mx-auto px-4 py-12">
    <!-- Breadcrumb nav -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-gray-400">
      <ol class="flex flex-wrap items-center gap-1">
        {breadcrumbItems.map((item, i) => (
          <li class="flex items-center gap-1">
            {i > 0 && <span class="text-gray-600">/</span>}
            {i < breadcrumbItems.length - 1 ? (
              <a href={item.url} class="hover:text-amber-400 transition-colors">{item.name}</a>
            ) : (
              <span class="text-gray-200 font-medium">{item.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- H1 -->
    <h1 class="text-3xl md:text-4xl font-bold mb-4 text-white">{title}</h1>

    <!-- Quick Answer -->
    {quickAnswer && (
      <div class="mb-8 p-4 rounded-lg bg-gray-800/50 border border-amber-500/20">
        <p class="text-gray-200 leading-relaxed">{quickAnswer}</p>
      </div>
    )}

    <!-- Optional summary table -->
    {summaryRows && summaryRows.length > 0 && (
      <div class="mb-8">
        <SummaryTable rows={summaryRows} />
      </div>
    )}

    <!-- Optional data disclaimer -->
    {showDisclaimer && <DataDisclaimer />}

    <!-- Custom content via slot -->
    <slot />

    <!-- FAQ -->
    {faq && faq.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold mb-6 text-white">Frequently Asked Questions</h2>
        <div class="flex flex-col gap-3">
          {faq.map((item) => (
            <FAQItem question={item.question} answer={item.answer} />
          ))}
        </div>
      </section>
    )}

    <!-- Optional related guides -->
    {relatedGuides && relatedGuides.length > 0 && (
      <div class="mt-12">
        <RelatedGuides links={relatedGuides} />
      </div>
    )}
  </article>
</BaseLayout>
