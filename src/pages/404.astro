---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Page Not Found - Broken Blade Guide';
const description = 'The page you are looking for does not exist. Return to the Broken Blade Guide homepage.';
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 py-24 text-center">
    <div class="mb-8">
      <span class="text-8xl font-bold text-amber-500">404</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Page Not Found</h1>
    <p class="text-gray-400 text-lg mb-8">
      The page you are looking for does not exist or has been moved. It may have been renamed or removed in a recent update.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 font-semibold text-gray-900 transition-colors hover:bg-amber-400">
        Go to Homepage
      </a>
      <a href="/wiki/" class="inline-flex items-center gap-2 rounded-lg border border-gray-600 px-6 py-3 font-semibold text-gray-200 transition-colors hover:border-amber-500 hover:text-amber-400">
        Browse Wiki
      </a>
    </div>
    <div class="mt-12">
      <h2 class="text-lg font-semibold text-white mb-4">Popular Pages</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/codes/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Codes</a>
        <span class="text-gray-600">|</span>
        <a href="/best-swords/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Best Swords</a>
        <span class="text-gray-600">|</span>
        <a href="/races/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Races</a>
        <span class="text-gray-600">|</span>
        <a href="/elements/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Elements</a>
        <span class="text-gray-600">|</span>
        <a href="/blessings/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Blessings</a>
        <span class="text-gray-600">|</span>
        <a href="/weapons/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Weapons</a>
        <span class="text-gray-600">|</span>
        <a href="/builds/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Builds</a>
        <span class="text-gray-600">|</span>
        <a href="/bosses/" class="text-amber-400 hover:text-amber-300 transition-colors text-sm">Bosses</a>
      </div>
    </div>
  </div>
</BaseLayout>
