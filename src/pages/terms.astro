---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGameConfig } from '@/lib/data';

const config = getGameConfig();

const title = 'Terms of Service - Broken Blade Guide';
const description = 'Terms of service for the Broken Blade Guide website. Read our terms before using the site.';
---

<BaseLayout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-6 text-white">Terms of Service</h1>
    <p class="text-sm text-gray-400 mb-8">Last updated: June 2026</p>

    <div class="space-y-6 text-gray-200 leading-relaxed">
      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">1. Acceptance of Terms</h2>
        <p class="text-gray-300">
          By accessing and using Broken Blade Guide ("the Site") at {config.seo.baseUrl}, you agree to be bound by these Terms of Service. If you do not agree with any part of these terms, please do not use the Site.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">2. Description of Service</h2>
        <p class="text-gray-300">
          Broken Blade Guide is a fan-made informational website providing guides, tier lists, codes, and other resources for the Roblox game {config.game.name}. The Site is provided free of charge for informational purposes only.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">3. Fan-Made Content Disclaimer</h2>
        <p class="text-gray-300">
          This Site is not affiliated with, endorsed by, or officially connected to {config.game.developer}, Roblox Corporation, or any of their subsidiaries or affiliates. All game names, images, and related content are trademarks of their respective owners.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">4. Accuracy of Information</h2>
        <p class="text-gray-300">
          We strive to provide accurate and up-to-date information. However, {config.game.name} receives regular updates, and some data may become outdated. We do not guarantee the accuracy, completeness, or timeliness of any information on the Site. Game data is reviewed regularly but may not always reflect the most recent in-game changes.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">5. Use of the Site</h2>
        <p class="text-gray-300 mb-2">You agree to use the Site only for lawful purposes and in accordance with these Terms. You agree not to:</p>
        <ul class="list-disc list-inside space-y-1 text-gray-300">
          <li>Use the Site in any way that violates applicable laws or regulations</li>
          <li>Attempt to gain unauthorized access to any part of the Site</li>
          <li>Use automated tools to scrape or collect data from the Site without permission</li>
          <li>Reproduce, distribute, or modify the content of the Site without authorization</li>
        </ul>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">6. Intellectual Property</h2>
        <p class="text-gray-300">
          The original content, design, and layout of this Site are the property of Broken Blade Guide. Game-related content, including but not limited to game names, characters, images, and mechanics, are the property of their respective owners.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">7. External Links</h2>
        <p class="text-gray-300">
          The Site may contain links to third-party websites. We are not responsible for the content, privacy policies, or practices of any third-party websites. Accessing third-party links is at your own risk.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">8. Limitation of Liability</h2>
        <p class="text-gray-300">
          The Site is provided "as is" without warranties of any kind. In no event shall Broken Blade Guide be liable for any damages arising from the use of or inability to use the Site or its content.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">9. Changes to Terms</h2>
        <p class="text-gray-300">
          We reserve the right to modify these Terms of Service at any time. Changes will be posted on this page with an updated revision date. Continued use of the Site after changes constitutes acceptance of the new terms.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">10. Contact</h2>
        <p class="text-gray-300">
          If you have questions about these Terms of Service, please visit our <a href="/contact/" class="text-amber-400 hover:text-amber-300 transition-colors">contact page</a>.
        </p>
      </section>
    </div>

    <div class="mt-8 text-center">
      <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 font-semibold text-gray-900 transition-colors hover:bg-amber-400">
        Back to Home
      </a>
    </div>
  </article>
</BaseLayout>
