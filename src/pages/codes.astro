---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import CodeTable from '@/components/CodeTable.astro';
import {
  getActiveCodes,
  getExpiredCodes,
  getGlobalFAQs,
  getPageFAQs,
  getCodesLastChecked,
  generateItemListSchema,
} from '@/lib/data';

const activeCodes = getActiveCodes();
const expiredCodes = getExpiredCodes();
const globalFAQ = getGlobalFAQs();
const pageFAQ = getPageFAQs('codes');
const codesLastChecked = getCodesLastChecked();

// Format the date nicely
const lastCheckedDate = new Date(codesLastChecked).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const faq = [
  ...pageFAQ,
  ...globalFAQ.filter(g => !pageFAQ.some(p => p.question === g.question)),
].slice(0, 10);

const codesSchema = generateItemListSchema(
  activeCodes.map((c, i) => ({
    name: `${c.code} - ${c.reward}`,
    url: `/codes/`,
    position: i + 1,
  }))
);

const title = 'Broken Blade Codes - Working Codes (June 2026)';
const description = 'All working Broken Blade Roblox codes for free rewards. Active codes, expired codes, and how to redeem.';

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Codes', url: '/codes/' },
];

const relatedGuides = [
  { title: 'Best Swords', url: '/best-swords/', description: 'Tier list of all weapons in Broken Blade.' },
  { title: 'Beginner Guide', url: '/beginner-guide/', description: 'Everything new players need to know.' },
  { title: 'Discord', url: '/discord/', description: 'Join the community Broken Blade Discord for new codes.' },
  { title: 'Wiki', url: '/wiki/', description: 'Complete Broken Blade wiki and guides.' },
];
---

<ArticleLayout
  title={title}
  description={description}
  quickAnswer={`There are currently ${activeCodes.length} active Broken Blade codes. Redeem them in-game for free rewards like Thunder, Beherit, Holy, and other rewards. Codes expire quickly, so redeem them as soon as possible.`}
  breadcrumbItems={breadcrumbItems}
  schema={codesSchema}
  faq={faq}
  relatedGuides={relatedGuides}
>
  <!-- Last Checked Banner -->
  <div class="mb-6 flex items-center gap-2 rounded-lg border border-amber-500/20 bg-gray-800/50 px-4 py-3">
    <span class="text-amber-400 text-sm">&#128270;</span>
    <p class="text-sm text-gray-300">Codes last checked: <strong class="text-gray-200">{lastCheckedDate}</strong>. We verify all codes regularly to keep this list accurate.</p>
  </div>

  <!-- Active Codes -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Active Codes</h2>
    {activeCodes.length > 0 ? (
      <>
        <CodeTable codes={activeCodes} showStatus={true} />
        <!-- Code details with source and date -->
        <div class="mt-4 space-y-2">
          {activeCodes.map(c => (
            <div class="rounded-lg border border-gray-700/50 bg-gray-800/30 p-3">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="font-mono font-bold text-amber-400 text-sm">{c.code}</span>
                <span class={`text-xs px-2 py-0.5 rounded ${c.status === 'active' ? 'bg-green-500/20 text-green-400' : 'bg-yellow-500/20 text-yellow-400'}`}>{c.status === 'active' ? 'Active' : 'Limited'}</span>
                {c.addedDate && <span class="text-xs text-gray-500">Added: {c.addedDate}</span>}
              </div>
              <p class="text-xs text-gray-400">Source: {c.source}</p>
              {c.notes && <p class="text-xs text-gray-500 mt-0.5">{c.notes}</p>}
            </div>
          ))}
        </div>
      </>
    ) : (
      <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6 text-center">
        <p class="text-gray-400">No active codes at the moment. Check back soon or join the <a href="/discord/" class="text-amber-400 hover:text-amber-300">community Discord</a> for updates.</p>
      </div>
    )}
  </section>

  <!-- Codes Not Working -->
  <section class="mb-10">
    <div class="rounded-lg border border-amber-500/20 bg-gray-800/50 p-5">
      <p class="text-gray-200">
        <span class="text-amber-400 font-medium">&#9888;&#65039; Having trouble with codes?</span>
        See our <a href="/codes-not-working/" class="text-amber-400 hover:text-amber-300 underline">Broken Blade Codes Not Working</a> guide for troubleshooting tips and solutions.
      </p>
    </div>
  </section>

  <!-- How to Redeem -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">How to Redeem Codes</h2>
    <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
      <ol class="list-decimal list-inside space-y-3 text-gray-200">
        <li>Open <strong class="text-white">Broken Blade</strong> in Roblox.</li>
        <li>Look for the <strong class="text-amber-400">Twitter bird icon</strong> or the <strong class="text-amber-400">Codes button</strong> on the left side of the screen.</li>
        <li>Click it to open the <strong class="text-white">code redemption window</strong>.</li>
        <li>Type or paste the code <strong class="text-white">exactly as shown</strong> (codes are case-sensitive).</li>
        <li>Press <strong class="text-amber-400">Enter</strong> or click <strong class="text-amber-400">Redeem</strong> to claim your reward.</li>
      </ol>
      <p class="mt-4 text-sm text-gray-400">Tip: Copy codes directly from the table above using the copy button to avoid typos.</p>
    </div>
  </section>

  <!-- Expired Codes -->
  {expiredCodes.length > 0 && (
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-white">Expired Codes</h2>
      <CodeTable codes={expiredCodes} showStatus={true} />
      <p class="mt-3 text-sm text-gray-500">These codes have expired and can no longer be redeemed. We keep them listed for reference.</p>
    </section>
  )}

  <!-- Where to Find New Codes -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Where to Find New Codes</h2>
    <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
      <ul class="space-y-3 text-gray-200">
        <li class="flex items-start gap-2">
          <span class="text-amber-400 mt-0.5">&#9733;</span>
          <span><strong class="text-white">Bookmark this page</strong> — we update codes as soon as they are released.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-amber-400 mt-0.5">&#9733;</span>
          <span><strong class="text-white">Community Discord</strong> — the developers often post codes in the announcements channel.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-amber-400 mt-0.5">&#9733;</span>
          <span><strong class="text-white">YouTube &amp; Twitter</strong> — content creators sometimes share exclusive codes.</span>
        </li>
      </ul>
    </div>
  </section>
</ArticleLayout>
