---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import TierTable from '@/components/TierTable.astro';
import TierBadge from '@/components/TierBadge.astro';
import {
  getBlessings,
  getBlessingsLastChecked,
  getGlobalFAQs,
  getPageFAQs,
  TIER_ORDER,
} from '@/lib/data';

const allBlessings = getBlessings();
const sortedBlessings = [...allBlessings].sort((a, b) => TIER_ORDER.indexOf(a.tier) - TIER_ORDER.indexOf(b.tier));
const globalFAQ = getGlobalFAQs();
const pageFAQ = getPageFAQs('blessings-tier-list');

const blessingsLastChecked = getBlessingsLastChecked();
const lastCheckedFormatted = new Date(blessingsLastChecked).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const bestBlessing = sortedBlessings[0];
const bestForBuster = sortedBlessings.find(b => b.bestFor.toLowerCase().includes('buster') || b.bestFor.toLowerCase().includes('damage')) || sortedBlessings[0];
const bestForBossRush = sortedBlessings.find(b => b.bestFor.toLowerCase().includes('boss rush') || b.bestFor.toLowerCase().includes('burst')) || sortedBlessings[0];

const sTierBlessings = sortedBlessings.filter(b => b.tier === 'S');
const aTierBlessings = sortedBlessings.filter(b => b.tier === 'A');

const faq = [
  ...pageFAQ,
  {
    question: 'What is the best blessing in Broken Blade?',
    answer: `The best blessing overall is <strong>${bestBlessing?.name || 'Odin'}</strong> (${bestBlessing?.tier || 'S'} Tier). It provides the strongest bonuses for general gameplay.`,
  },
  {
    question: 'How do I unlock blessings?',
    answer: 'Blessings are unlocked through specific in-game milestones, boss drops, or events. See the "How to Unlock" section below for details.',
  },
  {
    question: 'Can I change my blessing?',
    answer: 'Yes, you can change blessings by using a Blessing Reroll item or completing certain quests that grant a blessing change.',
  },
  {
    question: 'How do blessing drop rates work?',
    answer: 'Each blessing has a set drop rate. S-tier blessings have the lowest drop rates and are the rarest to obtain, while common blessings appear much more frequently.',
  },
  {
    question: 'Should I reroll a blessing for a specific build?',
    answer: 'Only if your current blessing does not match your weapon type at all. A well-matched A-tier blessing is often better than a mismatched S-tier one. Reroll when your build is otherwise optimized.',
  },
  {
    question: 'Do blessings stack with race and element bonuses?',
    answer: 'Yes, blessing effects stack additively or multiplicatively with race and element bonuses depending on the specific effect. This stacking is what makes full-build synergy so important.',
  },
].filter(item => !pageFAQ.some(p => p.question === item.question));

const title = 'Broken Blade Blessings Tier List';
const description = 'All Broken Blade blessings ranked. Best blessing for Buster, Boss Rush, and every weapon type.';

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Blessings Tier List', url: '/blessings-tier-list/' },
];

const relatedGuides = [
  { title: 'Best Swords', url: '/best-swords/', description: 'Tier list of all weapons in Broken Blade.' },
  { title: 'Boss Rush Guide', url: '/boss-rush-guide/', description: 'Best builds and strategies for Boss Rush.' },
  { title: 'Races Tier List', url: '/races-tier-list/', description: 'Best races for every build.' },
  { title: 'Elements Tier List', url: '/elements-tier-list/', description: 'Best elements for damage and crit.' },
  { title: 'Best Blessing for Buster', url: '/builds/best-blessing-for-buster/', description: 'Best blessings compared for Buster builds.' },
];
---

<ArticleLayout
  title={title}
  description={description}
  quickAnswer={`The best blessing in Broken Blade is ${bestBlessing?.name || 'Odin'} (${bestBlessing?.tier || 'S'} Tier). For Buster builds, ${bestForBuster?.name || 'Odin'} is ideal. For Boss Rush, ${bestForBossRush?.name || 'Odin'} provides the best burst damage.`}
  breadcrumbItems={breadcrumbItems}
  faq={faq}
  relatedGuides={relatedGuides}
>
  <!-- Last Checked Banner -->
  <div class="mb-6 flex items-center gap-2 rounded-lg border border-amber-500/20 bg-gray-800/50 px-4 py-3">
    <span class="text-amber-400 text-sm">&#128270;</span>
    <p class="text-sm text-gray-300">Data last checked: <strong class="text-gray-200">{lastCheckedFormatted}</strong>. Blessing rankings are reviewed after every major update.</p>
  </div>

  <!-- How Blessings Work -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">How Blessings Work in Broken Blade</h2>
    <p class="text-gray-200 mb-4 leading-relaxed">
      Blessings are the third pillar of character optimization in Broken Blade, working alongside races and elements to define your overall build. Each blessing grants powerful passive bonuses that can dramatically increase your damage output, improve survivability, or provide unique utility effects that change how your character plays.
    </p>
    <p class="text-gray-300 mb-4 leading-relaxed">
      Unlike basic stat boosts, blessings often provide multiplicative bonuses that scale exceptionally well with your other gear and attributes. This means that as your weapon, race, and element improve, your blessing becomes even more impactful. Choosing the right blessing is therefore a long-term investment that grows in value as you progress.
    </p>
    <p class="text-gray-300 leading-relaxed">
      Blessings are unlocked through gameplay milestones such as defeating specific bosses, completing quests, or reaching certain levels. Once unlocked, you can equip one active blessing at a time. Higher-rarity blessings provide stronger effects but are considerably harder to obtain, making them a long-term goal for dedicated players.
    </p>
  </section>

  <!-- Blessing Synergies -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Blessing Synergies with Builds</h2>
    <p class="text-gray-200 mb-4 leading-relaxed">
      The true power of blessings comes from how they interact with your weapon, race, and element. A blessing that amplifies raw damage synergizes best with Buster weapons and damage-focused races and elements. A blessing that boosts crit rate or crit damage pairs naturally with Katana builds that already prioritize speed and critical hits.
    </p>
    <p class="text-gray-300 mb-4 leading-relaxed">
      <strong class="text-white">For Boss Rush</strong>, the best blessings are those that maximize burst damage within a short time window. Boss Rush encounters are about dealing as much damage as possible quickly, so blessings that provide front-loaded damage bonuses or burst cooldowns are highly valued. Check our <a href="/boss-rush-guide/" class="text-amber-400 hover:text-amber-300">Boss Rush Guide</a> for specific blessing recommendations.
    </p>
    <p class="text-gray-300 leading-relaxed">
      <strong class="text-white">For general farming</strong>, sustained damage blessings or those with utility effects like increased drop rates can be more valuable than pure burst. Consider having different blessings for different activities if you have the flexibility to switch between them.
    </p>
  </section>

  <!-- Blessing Tier Table -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Blessing Tier List</h2>
    <TierTable items={sortedBlessings.map(b => ({
      name: b.name,
      tier: b.tier,
      rarity: b.rarity,
      description: b.bestFor,
      slug: b.slug,
      slugPrefix: 'blessings',
    }))} />
  </section>

  <!-- S-Tier Blessings -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">S-Tier Blessings - Most Powerful</h2>
    <p class="text-gray-200 mb-4 leading-relaxed">
      S-tier blessings are the rarest and most powerful in the game. They provide bonuses that can single-handedly define your build and are the top target for any player looking to maximize their potential.
    </p>
    <div class="space-y-3">
      {sTierBlessings.map(blessing => (
        <div class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-4">
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-bold text-white">{blessing.name}</h3>
            <TierBadge tier={blessing.tier} />
            <span class="text-sm text-gray-400">({blessing.rarity})</span>
          </div>
          <p class="text-gray-300 text-sm">{blessing.bestFor}</p>
          <p class="text-gray-400 text-xs mt-1">Drop Rate: {blessing.dropRate}</p>
          {blessing.effects && blessing.effects.length > 0 && (
            <ul class="list-disc list-inside text-xs text-gray-400 mt-1">
              {blessing.effects.map(e => <li>{e}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- A-Tier Blessings -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">A-Tier Blessings - Strong Picks</h2>
    <p class="text-gray-200 mb-4 leading-relaxed">
      A-tier blessings are excellent options that serve most players well. They are more accessible than S-tier blessings and provide strong bonuses that can carry you through all game content. Many experienced players use A-tier blessings as their primary choice while working toward obtaining an S-tier upgrade.
    </p>
    <div class="space-y-3">
      {aTierBlessings.map(blessing => (
        <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-4">
          <div class="flex items-center gap-3 mb-2">
            <h3 class="font-bold text-white">{blessing.name}</h3>
            <TierBadge tier={blessing.tier} />
            <span class="text-sm text-gray-400">({blessing.rarity})</span>
          </div>
          <p class="text-gray-300 text-sm">{blessing.bestFor}</p>
          <p class="text-gray-400 text-xs mt-1">Drop Rate: {blessing.dropRate}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Best Blessing Overall -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Best Blessing Overall</h2>
    <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
      <div class="flex items-center gap-3 mb-3">
        <h3 class="text-lg font-bold text-white">{bestBlessing?.name}</h3>
        <TierBadge tier={bestBlessing?.tier || 'S'} />
        <span class="text-sm text-gray-400">({bestBlessing?.rarity})</span>
      </div>
      <p class="text-gray-300 mb-2">{bestBlessing?.bestFor}</p>
      <p class="text-sm text-gray-400">Drop Rate: {bestBlessing?.dropRate}</p>
      <p class="text-sm text-gray-400 mt-1">Notes: {bestBlessing?.notes}</p>
      {bestBlessing?.effects && bestBlessing.effects.length > 0 && (
        <div class="mt-3">
          <p class="text-sm font-medium text-gray-200 mb-1">Effects:</p>
          <ul class="list-disc list-inside text-sm text-gray-400">
            {bestBlessing.effects.map(e => <li>{e}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- Best for Buster -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Best Blessing for Buster</h2>
    <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
      <div class="flex items-center gap-3 mb-3">
        <h3 class="text-lg font-bold text-white">{bestForBuster?.name}</h3>
        <TierBadge tier={bestForBuster?.tier || 'S'} />
      </div>
      <p class="text-gray-300 mb-2">{bestForBuster?.bestFor}</p>
      {bestForBuster?.effects && bestForBuster.effects.length > 0 && (
        <ul class="list-disc list-inside text-sm text-gray-400">
          {bestForBuster.effects.map(e => <li>{e}</li>)}
        </ul>
      )}
    </div>
  </section>

  <!-- Best for Boss Rush -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Best Blessing for Boss Rush</h2>
    <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
      <div class="flex items-center gap-3 mb-3">
        <h3 class="text-lg font-bold text-white">{bestForBossRush?.name}</h3>
        <TierBadge tier={bestForBossRush?.tier || 'S'} />
      </div>
      <p class="text-gray-300 mb-2">{bestForBossRush?.bestFor}</p>
      {bestForBossRush?.effects && bestForBossRush.effects.length > 0 && (
        <ul class="list-disc list-inside text-sm text-gray-400">
          {bestForBossRush.effects.map(e => <li>{e}</li>)}
        </ul>
      )}
    </div>
  </section>

  <!-- Blessing Reroll Strategy -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Blessing Reroll Strategy</h2>
    <p class="text-gray-200 mb-4 leading-relaxed">
      Blessing rerolls are one of the most expensive resource investments in the game. Because blessings have such a large impact on your overall build, it is important to be strategic about when you reroll and what you are willing to settle for.
    </p>
    <div class="space-y-3 mb-4">
      <div class="rounded-lg border border-green-500/30 bg-green-500/5 p-4">
        <h3 class="font-bold text-green-400 mb-1">Reroll When:</h3>
        <ul class="list-disc list-inside text-gray-300 text-sm space-y-1">
          <li>Your current blessing provides no useful bonuses for your weapon type</li>
          <li>You have an abundance of reroll resources and other build components are optimized</li>
          <li>You are pushing for competitive Boss Rush times and need every advantage</li>
          <li>Your blessing rarity is Common or Uncommon and you have access to higher tiers</li>
        </ul>
      </div>
      <div class="rounded-lg border border-red-500/30 bg-red-500/5 p-4">
        <h3 class="font-bold text-red-400 mb-1">Keep Your Blessing When:</h3>
        <ul class="list-disc list-inside text-gray-300 text-sm space-y-1">
          <li>You have an A-tier or S-tier blessing already equipped</li>
          <li>Your blessing synergizes with your current weapon, race, and element</li>
          <li>You are still in the process of upgrading your weapon or other core gear</li>
          <li>The blessing provides solid general bonuses even if it is not the theoretical best</li>
        </ul>
      </div>
    </div>
    <p class="text-gray-300 leading-relaxed">
      Remember that blessing effects stack with your other attributes. A well-matched A-tier blessing in a fully synergistic build will often outperform an S-tier blessing paired with mismatched race and element. Focus on full-build cohesion rather than chasing individual tier rankings.
    </p>
  </section>

  <!-- Blessing Drop Rates -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">Blessing Drop Rates Explained</h2>
    <p class="text-gray-200 mb-4 leading-relaxed">
      Blessing drop rates are rarity-weighted, meaning the most powerful blessings are intentionally rare. The system uses a gacha-style distribution where common blessings appear frequently while legendary ones are exceptionally rare.
    </p>
    <p class="text-gray-300 mb-4 leading-relaxed">
      Common blessings typically have drop rates around 30-40%, uncommon blessings around 20-30%, rare blessings around 10-20%, and epic blessings around 5-10%. Legendary or mythic blessings, which are usually the S-tier picks, can have drop rates as low as 1-3%, making them some of the rarest items in the game to obtain.
    </p>
    <p class="text-gray-300 leading-relaxed">
      Because of the steep rarity curve, it is generally not worth rerolling repeatedly for a specific S-tier blessing unless you have a large surplus of resources. An A-tier blessing that matches your build is a perfectly strong choice that will serve you well through all current content.
    </p>
  </section>

  <!-- How to Unlock -->
  <section class="mb-10">
    <h2 class="text-2xl font-bold mb-4 text-white">How to Unlock Blessings</h2>
    <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
      <ol class="list-decimal list-inside space-y-3 text-gray-200">
        <li>Reach the <strong class="text-white">required level</strong> for blessing unlocks.</li>
        <li>Complete <strong class="text-amber-400">specific quests</strong> or defeat bosses that drop blessing items.</li>
        <li>Visit the <strong class="text-white">Blessing Shrine</strong> NPC in the main hub.</li>
        <li>Select and equip your desired blessing from the unlocked options.</li>
      </ol>
      <p class="mt-4 text-sm text-gray-400">Tip: Higher rarity blessings are harder to obtain but provide significantly stronger effects.</p>
    </div>
  </section>
</ArticleLayout>
