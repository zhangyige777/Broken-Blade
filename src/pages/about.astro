---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGameConfig } from '@/lib/data';

const config = getGameConfig();

const title = 'About - Broken Blade Guide';
const description = 'About the Broken Blade Guide — a fan-made community wiki with codes, tier lists, builds, and progression guides for Broken Blade on Roblox.';
---

<BaseLayout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-6 text-white">About Broken Blade Guide</h1>

    <div class="space-y-6 text-gray-200 leading-relaxed">
      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">What Is This Site?</h2>
        <p>
          Broken Blade Guide is a fan-made community wiki dedicated to providing accurate, up-to-date information about the Roblox game <strong class="text-amber-400">{config.game.name}</strong> by {config.game.developer}.
        </p>
        <p class="mt-3">
          Our goal is to help players of all levels find the information they need, whether that is the latest codes, weapon tier lists, build recommendations, boss strategies, or progression guides.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">What We Cover</h2>
        <ul class="list-disc list-inside space-y-1 text-gray-300">
          <li>All active and expired codes</li>
          <li>Complete weapon tier lists and comparisons</li>
          <li>Race, element, and blessing rankings</li>
          <li>Optimized builds for every playstyle</li>
          <li>Boss strategies and farming guides</li>
          <li>Progression routes from beginner to endgame</li>
          <li>Forge and reforge guides</li>
          <li>Update logs and patch notes</li>
        </ul>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">Disclaimer</h2>
        <p class="text-gray-300">
          This website is not affiliated with, endorsed by, or connected to {config.game.developer} or Roblox Corporation. Broken Blade is a trademark of its respective owners. All game data is sourced from in-game observations and community contributions.
        </p>
        <p class="mt-3 text-gray-300">
          Game data is reviewed regularly but may not always reflect the most recent in-game changes. Last manual data review: {config.game.lastManualDataReview}.
        </p>
      </section>

      <div class="text-center">
        <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 font-semibold text-gray-900 transition-colors hover:bg-amber-400">
          Back to Home
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
