---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getGlobalFAQs, getPageFAQs } from '@/lib/data';

const globalFAQ = getGlobalFAQs();
const allPageFAQs: { question: string; answer: string; page: string }[] = [];
const pageNames = ['codes', 'best-swords', 'races-tier-list', 'blessings-tier-list', 'elements-tier-list', 'boss-rush', 'dragon-slayer-reforge', 'forge', 'progression', 'level-15000'];
for (const page of pageNames) {
  const pageFAQ = getPageFAQs(page);
  for (const faq of pageFAQ) {
    allPageFAQs.push({ ...faq, page });
  }
}

const allFAQs = [...globalFAQ, ...allPageFAQs];

const title = 'Broken Blade FAQ - Frequently Asked Questions';
const description = 'All Broken Blade frequently asked questions answered: best sword, best race, best blessing, codes, Trello, Discord, rerolls, boss rush, and more.';
const quickAnswer = 'Find answers to the most common Broken Blade questions below, including best weapons, races, elements, blessings, how to redeem codes, reroll mechanics, and boss rush strategies.';

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'FAQ', url: '/faq/' },
];

const relatedGuides = [
  { title: 'Codes', url: '/codes/', description: 'All active and expired Broken Blade codes.' },
  { title: 'Best Swords', url: '/best-swords/', description: 'Full weapon tier list.' },
  { title: 'Beginner Guide', url: '/beginner-guide/', description: 'Everything new players need to know.' },
  { title: 'Wiki', url: '/wiki/', description: 'Complete Broken Blade game database.' },
];
---

<ArticleLayout
  title={title}
  description={description}
  quickAnswer={quickAnswer}
  breadcrumbItems={breadcrumbItems}
  faq={allFAQs}
  relatedGuides={relatedGuides}
  showDisclaimer={false}
>
  <section class="mb-8">
    <h2 class="text-2xl font-bold text-white mb-2">All Questions</h2>
    <p class="text-gray-400 mb-6">{allFAQs.length} questions answered across all categories.</p>
  </section>
</ArticleLayout>
