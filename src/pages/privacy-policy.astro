---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGameConfig } from '@/lib/data';

const config = getGameConfig();

const title = 'Privacy Policy - Broken Blade Guide';
const description = 'Privacy policy for the Broken Blade Guide website. Learn how we handle your data and privacy.';
---

<BaseLayout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-6 text-white">Privacy Policy</h1>
    <p class="text-sm text-gray-400 mb-8">Last updated: June 2026</p>

    <div class="space-y-6 text-gray-200 leading-relaxed">
      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">1. Introduction</h2>
        <p class="text-gray-300">
          This Privacy Policy describes how Broken Blade Guide ("we", "us", or "our") collects, uses, and protects information when you visit our website at {config.seo.baseUrl} ("the Site").
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">2. Information We Collect</h2>
        <h3 class="font-semibold text-gray-100 mb-2">2.1 Automatically Collected Information</h3>
        <p class="text-gray-300 mb-3">
          When you visit the Site, we may automatically collect certain information, including:
        </p>
        <ul class="list-disc list-inside space-y-1 text-gray-300">
          <li>Browser type and version</li>
          <li>Operating system</li>
          <li>Referring website</li>
          <li>Pages visited and time spent on pages</li>
          <li>IP address (anonymized)</li>
          <li>Device type</li>
        </ul>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">3. Analytics</h2>
        <p class="text-gray-300">
          We use Google Analytics to collect and analyze usage data. Google Analytics uses cookies to track interactions on our Site. The data collected is used to improve our content and user experience. We do not link analytics data to personally identifiable information.
        </p>
        <p class="text-gray-300 mt-2">
          You can opt out of Google Analytics by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-300 transition-colors">Google Analytics Opt-out Browser Add-on</a>.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">4. Cookies</h2>
        <p class="text-gray-300">
          Our Site may use cookies for analytics purposes. We do not use cookies for advertising or tracking across other websites. You can control cookie settings through your browser preferences.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">5. Third-Party Links</h2>
        <p class="text-gray-300">
          Our Site may contain links to third-party websites, including the official Roblox game page and Discord server. We are not responsible for the privacy practices of these external sites. We encourage you to review their privacy policies.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">6. Children's Privacy</h2>
        <p class="text-gray-300">
          Our Site is a general-audience resource for a Roblox game. We do not knowingly collect personal information from children under 13. If you believe we have inadvertently collected such information, please contact us and we will promptly remove it.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">7. Data Security</h2>
        <p class="text-gray-300">
          We take reasonable measures to protect any information we collect. However, no method of electronic transmission or storage is 100% secure, and we cannot guarantee absolute security.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">8. Changes to This Policy</h2>
        <p class="text-gray-300">
          We may update this Privacy Policy from time to time. Any changes will be posted on this page with an updated revision date.
        </p>
      </section>

      <section class="rounded-lg border border-gray-700 bg-gray-800/50 p-6">
        <h2 class="text-xl font-bold text-white mb-3">9. Contact</h2>
        <p class="text-gray-300">
          If you have questions about this Privacy Policy, please visit our <a href="/contact/" class="text-amber-400 hover:text-amber-300 transition-colors">contact page</a>.
        </p>
      </section>
    </div>

    <div class="mt-8 text-center">
      <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-6 py-3 font-semibold text-gray-900 transition-colors hover:bg-amber-400">
        Back to Home
      </a>
    </div>
  </article>
</BaseLayout>
